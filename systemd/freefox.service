[Unit]
Description=FreeFox - service d'upload automatique de bags ROS 2
Documentation=https://github.com/thoukam/freefox
After=network-online.target
Wants=network-online.target
# Si ROS 2 tourne comme service systeme, decommenter:
# After=ros2.service

[Service]
Type=simple
# User/Group sont remplaces par install.sh (SERVICE_USER / SERVICE_GROUP).
User=freefox
Group=freefox

ExecStart=/usr/local/bin/freefox --config /etc/freefox/config.yaml

# Redemarre en cas d'erreur, avec 5s d'attente
Restart=always
RestartSec=5s

# Laisse jusqu'a 30s pour terminer proprement avant SIGKILL
TimeoutStopSec=30

# Les logs vont dans journald: journalctl -u freefox -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=freefox

# Durcissement securite, optionnel mais recommande
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Ajoutez le dossier des bags ici si delete_after_upload est active.
ReadWritePaths=/var/lib/freefox
ReadOnlyPaths=/etc/freefox

# Surcharges par variables d'environnement
# Environment=FREEFOX_ROBOT_ID=robot-01
# Environment=FREEFOX_CREDENTIALS=/etc/freefox/credentials.json
# Environment=FREEFOX_TOKEN_PATH=/var/lib/freefox/token.json
# Optionnel: variables AWS/profile stockees hors du depot, permissions 0640.
EnvironmentFile=-/etc/freefox/aws.env

[Install]
WantedBy=multi-user.target
